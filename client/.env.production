# Production Environment Variables
EXPO_PUBLIC_ENV=production
EXPO_PUBLIC_API_URL=https://your-domain.com/api
EXPO_PUBLIC_WS_URL=wss://your-domain.com/api
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_DEBUG=false

# Analytics
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ANALYTICS_ID=YOUR_ANALYTICS_ID

# Error Tracking
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Feature Flags
EXPO_PUBLIC_FEATURE_USER_SIDEBAR=true
EXPO_PUBLIC_FEATURE_THEME_TOGGLE=true
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_FEATURE_SOCIAL=true
EXPO_PUBLIC_FEATURE_BETA=false

# App Info
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=prod
