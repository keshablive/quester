# Environment Variables

# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# Environment (development, staging, production)
EXPO_PUBLIC_ENV=development

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
EXPO_PUBLIC_API_TIMEOUT=30000

# Debug
EXPO_PUBLIC_DEBUG=true

# Analytics
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ANALYTICS_ID=

# Error Tracking
EXPO_PUBLIC_SENTRY_DSN=

# App Info
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=dev

# Feature Flags
EXPO_PUBLIC_FEATURE_USER_SIDEBAR=true
EXPO_PUBLIC_FEATURE_THEME_TOGGLE=true
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_FEATURE_SOCIAL=true
EXPO_PUBLIC_FEATURE_BETA=false
