# ============================================================================
# Quester Platform - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://quester_user:quester_password@localhost:5432/quester_db?sslmode=disable

# Connection Pool Settings (recommended for production)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate keys with:
#   cd server/.keys
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem    # For Linux/WSL
#   base64 -i private.pem      # For macOS
#   certutil -encode private.pem private.b64 && type private.b64   # For Windows
# Then paste the base64 string below (remove newlines)

JWT_PRIVATE_KEY=PASTE_BASE64_ENCODED_PRIVATE_KEY_HERE
JWT_PUBLIC_KEY=PASTE_BASE64_ENCODED_PUBLIC_KEY_HERE

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRY=1h         # Access token lifespan (e.g., 1h, 15m)
JWT_REFRESH_TOKEN_EXPIRY=720h      # Refresh token lifespan (30 days = 720h)

# ============================================================================
# PASSWORD HASHING
# ============================================================================
# Bcrypt cost factor (non-negotiable: 12 for security)
# Higher = more secure but slower (adds ~250ms to signup/login)
BCRYPT_COST=12

# ============================================================================
# RATE LIMITING
# ============================================================================
# Signup rate limiting (per IP address)
RATE_LIMIT_SIGNUP_MAX=5            # Max requests per hour
RATE_LIMIT_SIGNUP_WINDOW=1h        # Time window

# Login rate limiting (per email address)
RATE_LIMIT_LOGIN_MAX=10            # Max requests per 15 minutes
RATE_LIMIT_LOGIN_WINDOW=15m        # Time window

# Token refresh rate limiting (per refresh token)
RATE_LIMIT_REFRESH_MAX=60          # Max requests per hour
RATE_LIMIT_REFRESH_WINDOW=1h       # Time window

# Token blacklist TTL (revoked tokens stay in Redis for this duration)
TOKEN_BLACKLIST_TTL=720h           # 30 days (same as refresh token expiry)

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8080
HOST=0.0.0.0
ENV=development                     # development, staging, production

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:19006,exp://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info                      # debug, info, warn, error
LOG_FORMAT=json                     # json, text

# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# SECURITY HEADERS
# ============================================================================
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000              # 1 year in seconds
CONTENT_SECURITY_POLICY=default-src 'self'

# ============================================================================
# MULTI-TENANT CONFIGURATION
# ============================================================================
# Default tenant ID for development (create this tenant in DB first)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Enable tenant isolation enforcement (should always be true in production)
TENANT_ISOLATION_ENABLED=true

# ============================================================================
# GAMIFICATION SETTINGS
# ============================================================================
# Initial user stats (applied on signup)
INITIAL_USER_LEVEL=1
INITIAL_USER_XP=0
INITIAL_USER_TIER=BRONZE

# Login streak reset window (hours)
LOGIN_STREAK_WINDOW=24             # Reset if no login within 24 hours

# ============================================================================
# VIDEO PROCESSING (FFmpeg)
# ============================================================================
# FFmpeg is required for video transcoding in US4 (Video Streaming)
# Download and install FFmpeg from: https://ffmpeg.org/download.html
# 
# Installation instructions:
#   - Windows: Download from https://www.gyan.dev/ffmpeg/builds/ and add to PATH
#   - macOS: brew install ffmpeg
#   - Linux: sudo apt-get install ffmpeg (Debian/Ubuntu) or sudo yum install ffmpeg (RHEL/CentOS)
#
# After installation, verify with: ffmpeg -version
# Set FFMPEG_PATH to the directory containing the ffmpeg binary
FFMPEG_PATH=/usr/local/bin         # Path to FFmpeg binary directory (adjust for your system)

# Video Streaming Configuration (Feature #003)
RTMP_SERVER_URL=rtmp://localhost:1935/live  # RTMP server for video ingestion
HLS_OUTPUT_PATH=/tmp/hls           # HLS output directory for transcoded streams
DVR_RECORDING_PATH=/tmp/recordings # DVR recordings storage path

# Video Transcoding Settings
VIDEO_TRANSCODE_ENABLED=true       # Enable multi-bitrate transcoding
VIDEO_QUALITIES=1080p,720p,480p    # Comma-separated quality options
VIDEO_PRESET=fast                  # FFmpeg preset (ultrafast, fast, medium, slow)
VIDEO_CRF=23                       # Constant Rate Factor (18-28, lower = better quality)

# Adaptive Bitrate (ABR) Settings
ABR_ENABLED=true                   # Enable adaptive bitrate streaming
ABR_SEGMENT_DURATION=3             # HLS segment duration (seconds)
ABR_PLAYLIST_LENGTH=60             # HLS playlist length (seconds)

# Video Latency & Performance (Feature #003 - Circuit Breaker)
VIDEO_LATENCY_TARGET=3000          # Target latency in milliseconds (<3s)
VIDEO_LATENCY_THRESHOLD=5000       # Circuit breaker threshold (>5s = abort)
VIDEO_MAX_CONCURRENT_STREAMS=100   # Maximum concurrent streams per instance

# ============================================================================
# AWS S3 STORAGE
# ============================================================================
# S3 is used for storing videos, documents, images, and user-generated content
# Supports AWS S3, MinIO, DigitalOcean Spaces, and other S3-compatible services
S3_REGION=us-east-1                # AWS region (e.g., us-east-1, ap-south-1)
S3_BUCKET=quester-media            # S3 bucket name
S3_ACCESS_KEY_ID=your_access_key   # AWS access key ID
S3_SECRET_ACCESS_KEY=your_secret   # AWS secret access key
S3_ENDPOINT=                       # Optional: Custom endpoint for MinIO/Spaces (leave empty for AWS S3)

# S3 Storage Paths (Feature #003)
S3_VIDEO_PATH=videos/              # Path prefix for video files
S3_CERTIFICATE_PATH=certificates/  # Path prefix for certificate PDFs
S3_DVR_PATH=dvr/                   # Path prefix for DVR recordings

# S3 Lifecycle Policies (Feature #003 - Tiered Storage)
S3_LIFECYCLE_ENABLED=true          # Enable automatic lifecycle transitions
S3_STANDARD_DAYS=7                 # Days in Standard storage (immediate access)
S3_IA_DAYS=30                      # Transition to Infrequent Access after N days
S3_GLACIER_DAYS=90                 # Transition to Glacier Deep Archive after N days
S3_DELETE_DAYS=0                   # Auto-delete after N days (0 = never delete)

# ============================================================================
# KEY MANAGEMENT SERVICE (KMS) - Feature #003
# ============================================================================
# KMS is used for encrypting sensitive data (2FA secrets, payment tokens, PII)
# Supports AWS KMS, Google Cloud KMS, and HashiCorp Vault

# KMS Provider Selection (aws, gcp, vault)
KMS_PROVIDER=aws                   # Options: aws, gcp, vault

# AWS KMS Configuration
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
AWS_KMS_REGION=us-east-1
AWS_KMS_ENDPOINT=                  # Optional: Localstack endpoint for development (e.g., http://localhost:4566)

# Google Cloud KMS Configuration
GCP_KMS_KEY_NAME=projects/PROJECT_ID/locations/LOCATION/keyRings/KEYRING/cryptoKeys/KEY
GCP_KMS_CREDENTIALS_PATH=.keys/gcp-kms-service-account.json

# HashiCorp Vault Configuration
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=s.xxxxxxxxxxxxxxxxxxxxxxxx
VAULT_MOUNT_PATH=transit           # Vault transit engine mount path
VAULT_KEY_NAME=quester-encryption-key

# KMS Settings
KMS_DEK_CACHE_TTL=3600             # Data Encryption Key cache TTL (seconds) - default 1 hour
KMS_ROTATION_SCHEDULE=90d          # Automatic key rotation schedule (days)

# ============================================================================
# FIREBASE CLOUD MESSAGING (Push Notifications)
# ============================================================================
# Firebase is used for sending push notifications to mobile devices
# Get credentials from: https://console.firebase.google.com/
# 1. Go to Project Settings → Service Accounts
# 2. Click "Generate New Private Key"
# 3. Save the JSON file to server/.keys/firebase-service-account.json
FCM_CREDENTIALS_PATH=.keys/firebase-service-account.json
FCM_PROJECT_ID=quester-app         # Firebase project ID

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================
# WebSocket settings for real-time features (chat, live streams, notifications)
WS_READ_BUFFER_SIZE=1024           # WebSocket read buffer size (bytes)
WS_WRITE_BUFFER_SIZE=1024          # WebSocket write buffer size (bytes)
WS_MAX_MESSAGE_SIZE=32768          # Maximum message size (32KB)
WS_PING_INTERVAL=54s               # Ping interval to keep connections alive
WS_PONG_TIMEOUT=60s                # Timeout for pong response

# ============================================================================
# PAYMENT GATEWAY WEBHOOKS
# ============================================================================
# Webhook secrets for payment gateway signature verification
# Get these from your payment gateway dashboard:
# - Razorpay: Dashboard → Settings → Webhooks → Secret
# - Stripe: Dashboard → Developers → Webhooks → Signing secret

RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ============================================================================
# MOBILE APP CONFIGURATION
# ============================================================================
# Used for push notifications, deep linking, etc. (future features)
MOBILE_APP_SCHEME=quester
MOBILE_IOS_BUNDLE_ID=com.quester.app
MOBILE_ANDROID_PACKAGE=com.quester.app

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
# Enable debug mode (verbose logging, detailed errors)
DEBUG=false

# Enable SQL query logging
DB_LOG_QUERIES=false

# Enable API request/response logging
LOG_HTTP_REQUESTS=true
LOG_HTTP_RESPONSES=false           # Warning: may log sensitive data

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Separate database for integration tests
TEST_DATABASE_URL=postgresql://quester_user:quester_password@localhost:5432/quester_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6379/1

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate JWT keys and base64 encode them (see JWT AUTHENTICATION section)
# 3. Update DATABASE_URL and REDIS_URL with your credentials
# 4. Set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY from encoded files
# 5. Adjust rate limits based on your expected traffic
# 6. Never commit .env to version control (add to .gitignore)
