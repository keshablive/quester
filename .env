# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://quester_user:quester_pass123@postgres:5432/quester_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_PRIVATE_KEY=base64_encoded_private_key_placeholder
JWT_PUBLIC_KEY=base64_encoded_public_key_placeholder
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h

# Security
BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Payment Configuration
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
