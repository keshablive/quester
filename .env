# ==============================================
# Quester Environment Configuration
# ==============================================

# ----------------------------------------------
# Server Configuration (Go)
# ----------------------------------------------
PORT=8000
HOST=0.0.0.0
ENV=development
DEBUG=true

# Database (Postgres)
# Note: 'postgres' is the service name in docker-compose
DATABASE_URL=postgres://quester_user:quester_pass123@postgres:5432/quester_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Cache (Redis)
# Note: 'redis' is the service name in docker-compose
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Security (JWT)
# IMPORTANT: Change these in production!
JWT_PRIVATE_KEY=dummy_private_key_for_dev_environment_only_do_not_use_in_prod
JWT_PUBLIC_KEY=dummy_public_key_for_dev_environment_only_do_not_use_in_prod
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h
BCRYPT_COST=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Metrics & Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Video Streaming (Nginx-RTMP)
RTMP_BASE_URL=rtmp://localhost:1935
CDN_BASE_URL=http://localhost:8080
STREAM_OUTPUT_DIR=/tmp/streams
FFMPEG_PATH=/usr/bin/ffmpeg

# ----------------------------------------------
# Client Configuration (Expo / React Native Web)
# ----------------------------------------------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
EXPO_PUBLIC_DEBUG=true

# Feature Flags
EXPO_PUBLIC_FEATURE_USER_SIDEBAR=true
EXPO_PUBLIC_FEATURE_THEME_TOGGLE=true
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_FEATURE_SOCIAL=true
EXPO_PUBLIC_FEATURE_BETA=false

# ----------------------------------------------
# Infrastructure (Docker Compose Services)
# ----------------------------------------------
# Postgres
POSTGRES_DB=quester_db
POSTGRES_USER=quester_user
POSTGRES_PASSWORD=quester_pass123

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
